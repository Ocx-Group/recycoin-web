{
  "compileOnSave": false,
  "compilerOptions": {
    "outDir": "./dist/out-tsc",
    "sourceMap": true,
    "declaration": false,
    "module": "esnext",
    "moduleResolution": "bundler",
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "useDefineForClassFields": false,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "typeRoots": [
      "node_modules/@types"
    ],
    "paths": {
      "@app/*": [
        "./src/app/*"
      ],
      "@environments/*": [
        "./src/environments/*"
      ]
    },
    "strict": true,
    // Fase 1 de la adopcion de strict: activadas strictFunctionTypes,
    // strictBindCallApply, noImplicitThis y alwaysStrict, que costaban 3
    // errores. Las tres que faltan son proyectos aparte: strictNullChecks
    // son 293 errores mas, noImplicitAny otros 315 y
    // strictPropertyInitialization otros 336.
    "strictNullChecks": false,
    "noImplicitAny": false,
    "strictPropertyInitialization": false
  },
  "exclude": [
    "node_modules/@types/webgl2",
    "test.ts",
    "**/*.spec.ts"
  ],
  "angularCompilerOptions": {
    "strictTemplates": true
  }
}
