{
  "compileOnSave": false,
  "compilerOptions": {
    "outDir": "./dist/out-tsc",
    "sourceMap": true,
    "declaration": false,
    "module": "esnext",
    "moduleResolution": "bundler",
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "useDefineForClassFields": false,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "typeRoots": [
      "node_modules/@types"
    ],
    "paths": {
      "@app/*": [
        "./src/app/*"
      ],
      "@environments/*": [
        "./src/environments/*"
      ]
    }
  },
  "exclude": [
    "node_modules/@types/webgl2",
    "test.ts",
    "**/*.spec.ts"
  ],
  "angularCompilerOptions": {}
}
